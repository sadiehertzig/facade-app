# Copy to .env.local for `npm run dev`. Never commit real values, and never
# rename these to NEXT_PUBLIC_*: the token must stay on the server.

# The PhotoGuard worker's base URL. https:// is required, except http:// is
# allowed for 127.0.0.1 or localhost (the fake worker, or the worker on the
# same server).
FACADE_PROCESSOR_URL=http://127.0.0.1:8000

# The worker's bearer token (at least 32 printable characters, no spaces).
# For the fake worker, use the same value you gave it.
FACADE_PROCESSOR_TOKEN=

# The address people type in the browser, e.g. https://facade.example.org.
# Required in production. In `npm run dev` it defaults to the request's origin.
FACADE_PUBLIC_ORIGIN=http://localhost:3000
