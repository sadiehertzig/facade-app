# FACADE server: the website (web/, a standard Next.js app) on 127.0.0.1:3000.
# Caddy serves it at https://$FACADE_HOST/ behind basic_auth.
# bootstrap.sh installs Node 22 LTS to /opt/facade/node, runs `npm ci` and
# `npm run build` in /opt/facade/src/web as the facade user, and writes
# /etc/facade/web.env (0400 facade): FACADE_PROCESSOR_URL (the loopback worker),
# FACADE_PROCESSOR_TOKEN (the worker bearer), FACADE_PUBLIC_ORIGIN and NODE_ENV.
[Unit]
Description=FACADE website (Next.js, 127.0.0.1:3000)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=facade
Group=facade
WorkingDirectory=/opt/facade/src/web
StandardOutput=journal
StandardError=journal
EnvironmentFile=/etc/facade/web.env
Environment=HOME=/var/lib/facade
Environment=PATH=/opt/facade/node/bin:/usr/bin:/bin
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/opt/facade/node/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
# The code is read-only; `next start` may write only its cache (the "-" skips a
# missing directory, which bootstrap.sh creates).
ReadOnlyPaths=/opt/facade
ReadWritePaths=-/opt/facade/src/web/.next/cache

[Install]
WantedBy=multi-user.target
