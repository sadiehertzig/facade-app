# FACADE server: the ported upstream MadryLab PhotoGuard Gradio demo
# (immunize + SD1.5-inpainting edit comparison, server/photoguard_demo/).
# Loopback only; Caddy serves it at https://$FACADE_HOST/photoguard/ behind
# basic_auth, so it runs with --root-path /photoguard.
# Gradio temp files go to the instance-store NVMe (/opt/dlami/nvme, wiped on
# stop/start) when it is mounted, else /var/tmp/facade-gradio. The directory is
# emptied on every start and stop; ExecStartPre writes the choice to
# /run/facade-demo.env, which overrides the Environment= default below.
[Unit]
# The name shown by `systemctl status` and in the logs.
Description=FACADE upstream PhotoGuard demo (Gradio, 127.0.0.1:7860)
# Start only together with facade-models (the verified model download),
Requires=facade-models.service
# and only after it has finished, and after the NVIDIA driver helper is up.
After=facade-models.service nvidia-persistenced.service
# Never give up restarting, however often it fails.
StartLimitIntervalSec=0

# [Service]: how to run it, and the limits it runs under.
[Service]
# A long-running program: systemd considers it started as soon as it launches.
Type=simple
# Run as the unprivileged `facade` system user (no login, no sudo), never as root.
User=facade
Group=facade
# Start in the service user's own home folder.
WorkingDirectory=/var/lib/facade
# Program output goes to the system journal (`facade_server.py logs`).
StandardOutput=journal
StandardError=journal
# A private home directory for the service user.
Environment=HOME=/var/lib/facade
# Hugging Face libraries: keep any cache in the service's own directory,
# never download anything at run time (the weights are already on disk,
# sha256-checked by facade-models), and send no usage statistics.
Environment=HF_HOME=/var/lib/facade/hf-home
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
# Gradio (the demo's web framework): send no usage statistics.
Environment=GRADIO_ANALYTICS_ENABLED=False
# Default folder for Gradio's temporary upload files (see the header).
Environment=GRADIO_TEMP_DIR=/var/tmp/facade-gradio
# Let PyTorch grow GPU memory blocks in place, which reduces wasted GPU memory.
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Python: write log lines at once (not buffered), and do not try to write
# .pyc cache files into the read-only code folder.
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# No progress bars in the logs.
Environment=TQDM_DISABLE=1
# The temp folder chosen by the ExecStartPre below (the "-" means the file
# may be missing, e.g. on the very first start).
EnvironmentFile=-/run/facade-demo.env
# nvidia-uvm: an unprivileged CUDA process under NoNewPrivileges cannot run the
# setuid nvidia-modprobe that creates /dev/nvidia-uvm on first use, so cuInit
# fails (999) after every reboot or stop/start. Create it as root first; the
# leading "-" keeps a failure here (e.g. no nvidia-modprobe binary) non-fatal.
ExecStartPre=-+/usr/bin/nvidia-modprobe -u -c=0
# As root (+): pick the temp folder (fast local NVMe disk if mounted, else
# /var/tmp), wipe any old one, create it for `facade` only, and record the
# choice in /run/facade-demo.env. ($$ is how a unit file writes a literal $.)
ExecStartPre=+/bin/sh -c 'd=/var/tmp/facade-gradio; if mountpoint -q /opt/dlami/nvme; then d=/opt/dlami/nvme/facade-gradio; fi; rm -rf /opt/dlami/nvme/facade-gradio /var/tmp/facade-gradio; install -d -m 0700 -o facade -g facade "$$d"; echo "GRADIO_TEMP_DIR=$$d" > /run/facade-demo.env'
# The demo: the PhotoGuard Gradio app, on loopback port 7860 only.
ExecStart=/opt/facade/venv/bin/python /opt/facade/src/server/photoguard_demo/app.py --snapshot /srv/facade/models/sd15-inpaint-8a4288 --host 127.0.0.1 --port 7860 --root-path /photoguard
# As root (+): delete every temporary upload when the demo stops.
ExecStopPost=+/bin/rm -rf /opt/dlami/nvme/facade-gradio /var/tmp/facade-gradio
# If the program stops for any reason, start it again after 5 seconds.
Restart=always
RestartSec=5
# Allow 30 seconds for a clean shutdown before it is killed.
TimeoutStopSec=30
# No core dumps: a crash must never write the process's memory (which may
# hold a photo or the token) to disk.
LimitCORE=0
# Files the service creates are readable by the `facade` user only.
UMask=0077
# The process and anything it starts can never gain more privileges than
# it started with (e.g. through a setuid program).
NoNewPrivileges=yes
# /home, /root and /run/user are invisible to the service.
ProtectHome=yes
# /usr, /boot and /etc are read-only for the service. (No PrivateTmp here:
# a private /var/tmp would hide the temp folder that ExecStartPre made.)
ProtectSystem=full
# The code, venv and Node.js stay read-only even if this process is compromised.
ReadOnlyPaths=/opt/facade

# [Install]: what `systemctl enable` hooks it into.
[Install]
# `systemctl enable` makes it start at every boot.
WantedBy=multi-user.target
